<?xml version="1.0" encoding="utf-8"?>
<!-- Manifesto da variante da MICROSOFT STORE do FappZap Acesso (atendimento com o cliente PRESENTE).
     Os valores de versão, identidade e publisher são preenchidos pelo fappzap/msix/montar-msix.ps1.

     Por que é mais enxuto que o AppxManifest.xml: dentro de um pacote da Store o Windows não deixa o
     serviço abrir o programa na sessão do usuário (erro 575, verificado em 04/10/2026), então NÃO há
     serviço aqui e, portanto, nada de acesso sem supervisão — esse continua sendo o MSI. Sem serviço,
     as capacidades restritas packagedServices e localSystemServices não fazem sentido e dariam trabalho
     (e risco) na análise da Store. Fica só o necessário: internet (servidor e conexão) e runFullTrust
     (o programa é um aplicativo de desktop completo, empacotado como a Store pede).
     O botão "Instalar" some (variante compilada com disable-installation): instalar copiaria o programa
     para fora do pacote, o que a Store não quer e o Windows não confiaria.
     A regra de entrada do firewall evita o aviso "Deseja permitir que redes públicas e privadas acessem
     este aplicativo?" na primeira abertura (visto na Sandbox, 05/10/2026), como o MSI já faz. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop2 rescap">

  <Identity Name="{IDENTIDADE}" Publisher="{PUBLISHER}" Version="{VERSAO}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>FappZap Acesso</DisplayName>
    <PublisherDisplayName>Fapp Solutions</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Acesso remoto da Fapp Solutions, baseado no RustDesk (AGPL-3.0).</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="pt-BR" />
    <Resource Language="en-US" />
    <Resource Language="es-ES" />
  </Resources>

  <Applications>
    <Application Id="FappZapAcesso" Executable="FappZap-Acesso.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="FappZap Acesso" Description="Acesso remoto da Fapp Solutions"
        BackgroundColor="#083344" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="fappzap-acesso">
            <uap:DisplayName>FappZap Acesso</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Extensions>
    <desktop2:Extension Category="windows.firewallRules">
      <desktop2:FirewallRules Executable="FappZap-Acesso.exe">
        <desktop2:Rule Direction="in" IPProtocol="TCP" Profile="all" />
        <desktop2:Rule Direction="in" IPProtocol="UDP" Profile="all" />
      </desktop2:FirewallRules>
    </desktop2:Extension>
  </Extensions>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
